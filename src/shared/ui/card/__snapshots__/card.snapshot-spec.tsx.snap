// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`Card snapshots > matches snapshot — default size 1`] = `
<div
  class="group/card flex flex-col gap-(--card-spacing) overflow-hidden rounded-xl bg-card py-(--card-spacing) text-sm text-card-foreground shadow-xs ring-1 ring-foreground/10 [--card-spacing:--spacing(6)] has-[>img:first-child]:pt-0 data-[size=sm]:[--card-spacing:--spacing(4)] *:[img:first-child]:rounded-t-xl *:[img:last-child]:rounded-b-xl"
  data-size="default"
  data-slot="card"
>
  <div
    class="group/card-header @container/card-header grid auto-rows-min items-start gap-1 rounded-t-xl px-(--card-spacing) has-data-[slot=card-action]:grid-cols-[1fr_auto] has-data-[slot=card-description]:grid-rows-[auto_auto] [.border-b]:pb-(--card-spacing)"
    data-slot="card-header"
  >
    <div
      class="font-heading text-base leading-normal font-medium group-data-[size=sm]/card:text-sm"
      data-slot="card-title"
    >
      Summary
    </div>
  </div>
  <div
    class="flex flex-col gap-3 px-(--card-spacing)"
    data-slot="card-content"
  >
    Totals for the range.
  </div>
</div>
`;

