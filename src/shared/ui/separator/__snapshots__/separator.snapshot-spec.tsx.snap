// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`Separator snapshots > matches snapshot — horizontal 1`] = `
<div
  aria-orientation="horizontal"
  class="shrink-0 bg-border data-horizontal:h-px data-horizontal:w-full data-vertical:w-px data-vertical:self-stretch"
  data-orientation="horizontal"
  data-slot="separator"
  role="separator"
/>
`;

exports[`Separator snapshots > matches snapshot — vertical 1`] = `
<div
  aria-orientation="vertical"
  class="shrink-0 bg-border data-horizontal:h-px data-horizontal:w-full data-vertical:w-px data-vertical:self-stretch"
  data-orientation="vertical"
  data-slot="separator"
  role="separator"
/>
`;
