{
  "name": "supply-chain-admin-panel",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev --port 3000",
    "dev:live": "cross-env VITE_ENABLE_MOCKS=false vite dev --port 3000",
    "build": "cross-env NODE_ENV=production vite build",
    "preview": "vite preview --port 4173",
    "test": "cross-env NODE_ENV=test TZ=UTC vitest run --project unit --project integration --project snapshot --project screenshot",
    "test:unit": "cross-env NODE_ENV=test TZ=UTC vitest run --project unit",
    "test:int": "cross-env NODE_ENV=test TZ=UTC vitest run --project integration",
    "test:snapshot": "cross-env NODE_ENV=test TZ=UTC vitest run --project snapshot",
    "test:watch": "cross-env NODE_ENV=test TZ=UTC vitest --project unit --project integration --project snapshot",
    "test:screenshot": "cross-env NODE_ENV=test TZ=UTC vitest run --project screenshot",
    "test:screenshot:update": "cross-env NODE_ENV=test TZ=UTC vitest run --project screenshot -u",
    "test:stories": "cross-env NODE_ENV=test TZ=UTC vitest run --project storybook",
    "test:e2e": "playwright test --config=tests/configs/playwright.e2e.config.ts",
    "test:all": "cross-env NODE_ENV=test TZ=UTC vitest run",
    "lint": "oxlint --threads=4",
    "lint:fix": "oxlint --threads=4 --fix",
    "format": "biome format --write .",
    "check": "biome check .",
    "check:fix": "biome check --write .",
    "typecheck": "tsc --noEmit",
    "verify": "pnpm lint && pnpm check && pnpm typecheck",
    "storybook": "cross-env STORYBOOK=true storybook dev -p 6006",
    "storybook:build": "cross-env STORYBOOK=true NODE_ENV=production storybook build",
    "commit": "cz",
    "prepare": "lefthook install",
    "test:screenshot:install": "playwright install --with-deps chromium firefox webkit"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@fontsource-variable/raleway": "^5.3.0",
    "@fontsource-variable/roboto": "^5.3.0",
    "@hookform/resolvers": "^5.9.1",
    "@tailwindcss/vite": "^4",
    "@tanstack/react-devtools": "^0.10.12",
    "@tanstack/react-query": "^5.103.1",
    "@tanstack/react-query-devtools": "^5.103.1",
    "@tanstack/react-router": "^1.170.38",
    "@tanstack/react-router-devtools": "^1.167.2",
    "@tanstack/react-router-ssr-query": "^1.167.3",
    "@tanstack/react-start": "^1.168.56",
    "@tanstack/router-plugin": "^1.168.40",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cn": "^0.2.6",
    "d3-geo": "^3.1.1",
    "date-fns": "^4.4.0",
    "i18next": "^26.4.2",
    "i18next-browser-languagedetector": "^8.2.1",
    "lucide-react": "^1.47.0",
    "msw": "^2.15.0",
    "next-themes": "^0.4.6",
    "nuqs": "^2.10.1",
    "ofetch": "^1.5.1",
    "react": "^19.2.8",
    "react-day-picker": "^10.0.1",
    "react-dom": "^19.2.8",
    "react-hook-form": "^7.88.0",
    "react-i18next": "^17.0.14",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4",
    "topojson-client": "^3.1.0",
    "tw-animate-css": "^1.4.0",
    "world-atlas": "^2.0.2",
    "write-excel-file": "^4.1.1",
    "zod": "^4.6.5",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.14",
    "@chromatic-com/storybook": "^5.3.1",
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@hookform/devtools": "^4.4.0",
    "@playwright/test": "^1.63.0",
    "@storybook/addon-a11y": "^10.6.0",
    "@storybook/addon-docs": "^10.6.0",
    "@storybook/addon-mcp": "^10.6.0",
    "@storybook/addon-vitest": "^10.6.0",
    "@storybook/tanstack-react": "^10.6.0",
    "@tanstack/devtools-vite": "^0.8.5",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.7",
    "@types/d3-geo": "^3.1.1",
    "@types/geojson": "^7946.0.16",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/topojson-client": "^3.1.5",
    "@types/topojson-specification": "^1.0.5",
    "@vitejs/plugin-react": "^6",
    "@vitest/browser-playwright": "4.1.11",
    "@vitest/coverage-v8": "4.1.11",
    "commitizen": "^4.3.2",
    "cross-env": "^10.1.0",
    "cz-customizable": "^7.5.4",
    "jsdom": "^30",
    "lefthook": "^2.1.14",
    "oxlint": "^1.83.0",
    "playwright": "^1.63.0",
    "shadcn": "^4.21.0",
    "storybook": "^10.6.0",
    "typescript": "^6",
    "vite": "^8",
    "vitest": "^4"
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  },
  "license": "SEE LICENSE IN LICENSE",
  "author": "Vladyslav Tesliuk",
  "config": {
    "commitizen": {
      "path": "./node_modules/cz-customizable"
    },
    "cz-customizable": {
      "config": ".cz-config.cjs"
    }
  },
  "browserslist": [
    "chrome >= 111",
    "firefox >= 113",
    "safari >= 16.4",
    "edge >= 111"
  ],
  "engines": {
    "node": "24.21.0",
    "pnpm": ">=10"
  },
  "packageManager": "pnpm@10.15.0"
}
