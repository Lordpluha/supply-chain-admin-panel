{
  "permissions": {
    "allow": [
      "Bash(which *)",
      "Bash(rg *)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git show*)",
      "Bash(git branch*)",
      "Bash(git ls-files*)",
      "Bash(git check-ignore *)",
      "Bash(pnpm install*)",
      "Bash(pnpm add *)",
      "Bash(pnpm exec *)",
      "Bash(pnpm dlx *)",
      "Bash(pnpm lint*)",
      "Bash(pnpm format*)",
      "Bash(pnpm check*)",
      "Bash(pnpm typecheck*)",
      "Bash(pnpm verify*)",
      "Bash(pnpm test*)",
      "Bash(pnpm build*)",
      "Bash(pnpm dev*)",
      "Bash(pnpm storybook*)",
      "Bash(npx ctx7@latest *)",
      "Bash(docker build*)",
      "Bash(docker compose*)",
      "WebFetch(domain:tanstack.com)",
      "WebFetch(domain:tailwindcss.com)",
      "WebFetch(domain:base-ui.com)",
      "WebFetch(domain:ui.shadcn.com)",
      "WebFetch(domain:zod.dev)",
      "WebFetch(domain:mswjs.io)",
      "WebFetch(domain:nuqs.dev)",
      "WebFetch(domain:zustand.docs.pmnd.rs)",
      "WebFetch(domain:biomejs.dev)",
      "WebFetch(domain:oxc.rs)",
      "WebFetch(domain:storybook.js.org)",
      "WebFetch(domain:vitest.dev)",
      "WebFetch(domain:d3js.org)",
      "WebFetch(domain:www.i18next.com)",
      "WebFetch(domain:raw.githubusercontent.com)",
      "WebFetch(domain:github.com)"
    ],
    "deny": [
      "Bash(cat **/.env.local)",
      "Bash(cat .env.local)",
      "Bash(cat .env)",
      "Read(//**/.env.local)",
      "Read(//**/.env)",
      "Read(./.env.*.local)",
      "Read(./.env.local)",
      "Read(./.env)",
      "Read(//proc/*/environ)",
      "Read(//**/.ssh/**)",
      "Read(//**/.aws/**)",
      "Read(//**/.gnupg/**)",
      "Read(//**/.docker/config.json)",
      "Read(//**/.npmrc)",
      "Read(//**/.git-credentials)",
      "Read(//**/id_rsa*)",
      "Read(//**/id_ed25519*)",
      "Read(//**/*.pem)",
      "Bash(env)",
      "Bash(printenv*)",
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git reset --hard*)",
      "Bash(git clean -fd*)",
      "Read(./node_modules/**)",
      "Read(./dist/**)",
      "Read(./.output/**)",
      "Read(./.tanstack/**)",
      "Read(./storybook-static/**)",
      "Read(./coverage/**)",
      "Read(./public/mockServiceWorker.js)",
      "Read(./src/routeTree.gen.ts)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Read|Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/block-env-access.sh\""
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/format-on-edit.sh\""
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "mattpocock-skills@claude-plugins-official": true
  }
}
