# Copy to `.env` and adjust.
#
# Every value is inlined by Vite at BUILD time — changing one after a build has
# no effect, so rebuild (or rebuild the image). Only `VITE_`-prefixed variables
# reach the browser bundle.
#
# This project has no secrets: the API is mocked inside the bundle. Keep it that
# way — if a real credential is ever needed, it belongs on a server, not here.

# Base path or origin the panel calls. With mocks on, this is the path MSW
# intercepts; with mocks off, point it at a real API origin.
VITE_API_URL=/api

# Mock Service Worker. `false` sends requests to VITE_API_URL for real.
# The prototype ships with this on — there is no backend to talk to.
VITE_ENABLE_MOCKS=true
